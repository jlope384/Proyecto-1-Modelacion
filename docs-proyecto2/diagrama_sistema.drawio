<mxfile host="app.diagrams.net" agent="Proyecto 2 CC3074" version="24.0.0">
  <diagram id="sistema-piso" name="Sistema del piso">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="titulo" value="&lt;b&gt;Sistema simulado: un día en el piso del casino&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="Simulación de eventos discretos. Eventos: llegada, fin de servicio y abandono de la cola." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="760" height="30" as="geometry" />
        </mxCell>

        <!-- Flujo principal -->
        <mxCell id="llegada" value="&lt;b&gt;Llega un cliente&lt;/b&gt;&lt;br&gt;Poisson no homogéneo λ(t)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nivel y día: Grand Korea Leisure&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f1ebfb;strokeColor=#7b52d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="elige" value="&lt;b&gt;Elige un juego&lt;/b&gt;&lt;br&gt;según los pesos&lt;br&gt;de demanda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9dcff;strokeColor=#7b52d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="175" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="libre" value="&lt;b&gt;¿Hay un puesto&lt;br&gt;libre?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d6f3ff;strokeColor=#1f9fd6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="juega" value="&lt;b&gt;Juega su sesión&lt;/b&gt;&lt;br&gt;rondas reales del juego,&lt;br&gt;apuesta y duración aleatorias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9dcff;strokeColor=#7b52d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="170" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sale" value="&lt;b&gt;Sale del casino&lt;/b&gt;&lt;br&gt;se quedó sin dinero, llegó&lt;br&gt;a su meta o a su tiempo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f1ebfb;strokeColor=#7b52d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cola" value="&lt;b&gt;Espera en la cola&lt;/b&gt;&lt;br&gt;de ese juego" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9dcff;strokeColor=#7b52d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="abandona" value="&lt;b&gt;Abandona&lt;/b&gt;&lt;br&gt;sin jugar" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffd6ec;strokeColor=#c0287f;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="405" y="470" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Flechas -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="llegada" target="elige">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="elige" target="libre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="libre" target="juega">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="juega" target="sale">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="libre" target="cola">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="se libera un puesto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cola" target="juega">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="se acaba su paciencia&lt;br&gt;(exponencial, media 8 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#c0287f;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cola" target="abandona">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="al salir libera su puesto:&lt;br&gt;entra el siguiente de la cola" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;strokeColor=#7b52d6;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="sale" target="cola">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="935" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cajas de contexto -->
        <mxCell id="generador" value="&lt;b&gt;Generador de números aleatorios&lt;/b&gt;&lt;br&gt;LCG propio con transformada inversa&lt;br&gt;y aceptación-rechazo.&lt;br&gt;Alimenta llegadas, juego elegido, paciencia,&lt;br&gt;dinero de cada cliente y cada ronda." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#888888;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="590" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="recursos" value="&lt;b&gt;Recursos: área fija del piso (142 u.a.)&lt;/b&gt;&lt;br&gt;Tragamonedas: 1 puesto · 1 u.a.&lt;br&gt;Blackjack: 5 puestos · 6 u.a.&lt;br&gt;Ruleta: 7 puestos · 8 u.a.&lt;br&gt;Dados: 8 puestos · 10 u.a.&lt;br&gt;Base 100 / 4 / 1 / 1 · Mejorada 84 / 5 / 1 / 2" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d6f3ff;strokeColor=#1f9fd6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="590" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="metricas" value="&lt;b&gt;Salidas de cada día&lt;/b&gt;&lt;br&gt;Ingreso (u.m.), espera, abandono,&lt;br&gt;utilización y hold por juego.&lt;br&gt;Chequeos: ley de Little y&lt;br&gt;llegadas = atendidos + abandonos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f1ebfb;strokeColor=#7b52d6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="590" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ga" value="&lt;b&gt;Algoritmo genético&lt;/b&gt;&lt;br&gt;propone un reparto de mesas y máquinas&lt;br&gt;que ocupa exactamente 142 u.a." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b38600;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="760" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="define cuántas&lt;br&gt;unidades hay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;strokeColor=#b38600;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ga" target="recursos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="fitness = ingreso medio de 10 días&lt;br&gt;− penalización si abandono &amp;gt; 10 %" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;strokeColor=#b38600;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="metricas" target="ga">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
